# Strong shared secret; Laravel sends this as the X-Service-Token header.
AI_SERVICE_TOKEN=replace-with-a-long-random-secret
AI_ENVIRONMENT=local

# Provider selection. "stub" runs the contracts without real models.
AI_TRANSCRIPTION_PROVIDER=stub
AI_DIARIZATION_PROVIDER=stub
AI_LANGUAGE_PROVIDER=stub
AI_TRANSLATION_PROVIDER=stub
AI_LLM_PROVIDER=stub
AI_EMBEDDING_PROVIDER=stub

AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
