APP_NAME="MeetingAI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://meeting-ai.test
APP_FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite for local development. PostgreSQL remains available for production
# vector search deployments.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# No Redis in this deployment. Sessions/cache use the zero-infra file driver;
# the queue uses the `database` driver (via the jobs/job_batches/failed_jobs
# migration) so the AI pipeline still runs asynchronously, never inline in a
# web request — see ARCHITECTURE.md → Queue architecture.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Sanctum SPA
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@meetingai.example"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth + Calendar/Meet (see app/README.md → Google integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://meeting-ai.test/api/v1/auth/google/callback

# Python AI service (see ai-service/README.md)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=change-me-to-a-long-random-secret
AI_SERVICE_TIMEOUT=300
AI_QUEUE=ai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
